# docmesh-kbms application configuration

# Fixed DMS identity used by the application.
KBMS_USER_ID=dms
# The REST API always uses partition_kind=personal and partition_id=kbms.

# SQLAlchemy async database URL.
# In-memory alternative: sqlite+aiosqlite:///:memory:
KBMS_DATABASE_URL=sqlite+aiosqlite:///./kbms.db

# MinIO / S3-compatible object storage.
KBMS_MINIO_ENDPOINT=localhost:9000
KBMS_MINIO_ACCESS_KEY=minioadmin
KBMS_MINIO_SECRET_KEY=minioadmin123
KBMS_MINIO_BUCKET=kbms-documents
KBMS_MINIO_SECURE=false

# Ollama embedding service.
KBMS_OLLAMA_ENDPOINT=http://192.168.219.106:11434
KBMS_OLLAMA_MODEL=bge-m3

# Milvus Lite local database.
# For a Milvus server, use an URI such as http://localhost:19530.
KBMS_MILVUS_URI=./milvus.db

# Embedding and chunking defaults for bge-m3.
KBMS_COLLECTION_NAME=kbms_documents
KBMS_VECTOR_DIMENSION=1024
KBMS_CHUNK_SIZE=1000
KBMS_CHUNK_OVERLAP=100
